# Same-origin path only. Dev (:5173) and Docker (:3000) both proxy /api/litellm.
# Never set http://localhost:4000 here — the browser cannot call LiteLLM directly (CORS).
VITE_LITELLM_BASE_URL=/api/litellm

# OpenAI-compatible bearer token for LiteLLM.
# Note: VITE_* values are embedded in the browser bundle. Use only for local/trusted deployments.
VITE_LITELLM_API_KEY=

# true = built-in mock models; false = call LiteLLM via proxy.
VITE_USE_MOCK_LITELLM=true

# true = agents chat with each other via LLM when paired in the scene.
VITE_ENABLE_AGENT_PEER_CHAT=true

# Optional external agent roster. Defaults to /agents.json.
# VITE_AGENTS_CONFIG_URL=/agents.json

# --- Dev only: Vite proxy upstream (vite.config.ts, not in the bundle) ---
LITELLM_PROXY_TARGET=http://localhost:4000

# --- Docker only: nginx runtime (docker compose, not used by Vite) ---
LITELLM_UPSTREAM=http://host.docker.internal:4000
OFFICE_MAP_PORT=3000
