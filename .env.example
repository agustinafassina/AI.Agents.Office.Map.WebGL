# LiteLLM proxy base (dev uses Vite proxy at /api/litellm)
VITE_LITELLM_BASE_URL=/api/litellm

# API key for LiteLLM (OpenAI-compatible Bearer token)
VITE_LITELLM_API_KEY=

# Set to false when using a real LiteLLM instance with API key
VITE_USE_MOCK_LITELLM=true

# Optional: external agent roster + system prompts (default /agents.json)
# VITE_AGENTS_CONFIG_URL=/agents.json
