# --- LiteLLM ---
# Browser-facing base URL. In local dev and Docker, keep /api/litellm so Vite/nginx can proxy it.
# Do not point this at http://localhost:4000 in dev — the browser cannot call LiteLLM directly (CORS).
VITE_LITELLM_BASE_URL=/api/litellm

# Vite dev proxy upstream (only used by vite.config.ts, not embedded in the bundle).
# LITELLM_PROXY_TARGET=http://localhost:4000

# OpenAI-compatible bearer token for LiteLLM.
# Note: VITE_* values are embedded in the browser bundle. Use only for local/trusted deployments.
VITE_LITELLM_API_KEY=

# true = use built-in mock models; false = call LiteLLM.
VITE_USE_MOCK_LITELLM=true

# true = agents chat with each other via LLM when paired in the scene (logged for download).
VITE_ENABLE_AGENT_PEER_CHAT=true

# Optional external agent roster + system prompts. Defaults to /agents.json.
# VITE_AGENTS_CONFIG_URL=/agents.json

# --- Docker (docker compose) ---
# Host port for the web app.
# OFFICE_MAP_PORT=3000

# Runtime nginx upstream for /api/litellm when using Docker.
# LITELLM_UPSTREAM=http://host.docker.internal:4000
